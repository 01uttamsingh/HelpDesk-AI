{
  "name": "helpdesk-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "bun prisma/seed.ts",
    "prisma:seed:tickets": "bun prisma/seed-tickets.ts",
    "prisma:studio": "prisma studio",
    "db:test:setup": "bun ../e2e/scripts/setup-test-db.ts",
    "db:test:reset": "bun ../e2e/scripts/setup-test-db.ts --reset",
    "test:server": "bun run db:test:setup && bun src/index.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@better-auth/core": "1.7.2",
    "@better-auth/prisma-adapter": "1.7.2",
    "@google/genai": "^2.21.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "ai": "^7.0.93",
    "better-auth": "^1.7.2",
    "better-call": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "prisma": "7.10.0",
    "typescript": "^5.7.2"
  }
}
