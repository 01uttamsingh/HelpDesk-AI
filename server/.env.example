# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/helpdesk_db?schema=public

# Session Secret
SESSION_SECRET=super-secret-session-key-change-in-production

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Email Delivery (SendGrid / Mailgun)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SUPPORT_EMAIL=support@yourdomain.com
