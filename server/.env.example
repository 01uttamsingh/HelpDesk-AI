# -----------------------------------------------------------------------------
# Server & Environment Configuration
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Public URLs (In Railway, automatically detected from RAILWAY_PUBLIC_DOMAIN if left blank)
# Set to your live Railway domain, e.g. https://your-helpdesk.up.railway.app
CLIENT_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5000
TRUSTED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Database Connection (PostgreSQL 16+)
# -----------------------------------------------------------------------------
# On Railway, automatically provisioned or reference ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/helpdesk?schema=public

# -----------------------------------------------------------------------------
# Better Auth Configuration
# -----------------------------------------------------------------------------
# Secret used for session encryption (minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_long

# -----------------------------------------------------------------------------
# Initial Admin Credentials (Seeded into DB on startup if not present)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_secure_password
ADMIN_NAME=Admin

# -----------------------------------------------------------------------------
# AI Services (OpenAI GPT-5.6 / GPT-4o for ticket triage, auto-resolve & summary)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# -----------------------------------------------------------------------------
# Outbound Email Delivery (Resend HTTPS API or SMTP)
# -----------------------------------------------------------------------------
# Resend is recommended for Railway/cloud deployments (bypasses blocked SMTP ports)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=HelpDesk Support <onboarding@resend.dev>

# Fallback SMTP / Gmail settings
EMAIL_PROVIDER=gmail
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn@ingest.sentry.io/project_id
