# -----------------------------------------------------------------------------
# Helpdesk Monorepo Environment Configuration (Production & Railway)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# Public URLs (In Railway, automatically detected from RAILWAY_PUBLIC_DOMAIN if left blank)
CLIENT_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5000
TRUSTED_ORIGINS=http://localhost:5173

# Database Connection (PostgreSQL 16+)
# On Railway, reference ${{Postgres.DATABASE_URL}} or Railway auto-injects DATABASE_URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/helpdesk?schema=public

# Better Auth Session Encryption Key (Minimum 32 characters)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_long

# Initial Administrator Account (Seeded idempotently on startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_secure_password
ADMIN_NAME=Admin

# OpenAI API Key (For AI ticket classification, reply polishing, auto-resolve & summary)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Outbound Email Delivery (SMTP / Gmail)
EMAIL_PROVIDER=gmail
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Sentry Monitoring (Optional)
SENTRY_DSN=https://your_sentry_dsn@ingest.sentry.io/project_id
